# Copy this file to .env and put your own values there. .env is never pushed to Git.
COLLAB_SECRET_KEY=any-long-random-string
COLLAB_ENV_ID=local
COLLAB_ADMIN_URL=admin/

# Only for COLLAB_ENV_ID=prod (PostgreSQL)
COLLAB_POSTGRES_DB=collabhub
COLLAB_POSTGRES_USER=postgres
COLLAB_POSTGRES_PASSWORD=postgres
COLLAB_POSTGRES_HOST=localhost
COLLAB_POSTGRES_PORT=5432
